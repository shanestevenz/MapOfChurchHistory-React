{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "auth:migrate": "node --env-file-if-exists=.env.local scripts/auth-cli.mjs migrate --yes",
    "auth:create-admin": "node --env-file-if-exists=.env.local scripts/auth-cli.mjs create-admin",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-neon.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-neon.mjs",
    "db:start": "docker compose up -d db",
    "db:stop": "docker compose down",
    "db:seed:generate": "node scripts/generate-neon-seed.cjs",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "production:check": "node scripts/check-production-env.mjs",
    "load:test": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/functions": "^3.11.3",
    "better-auth": "^1.7.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.29.9",
    "lucide-react": "^1.16.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "^1.7.23",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5",
    "shadcn": "^4.8.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  }
}
