# Values printed by `npx supabase status` after `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key

# Server-only. Copy the secret key printed by `npx supabase status` for local API tests.
# In Vercel, use the staging or production sb_secret_ key and never prefix it NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key

# Cloudflare Turnstile. Leave blank locally to use the development bypass.
# Production refuses suggestion submissions and admin sign-in if these are missing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# A generated secret used to HMAC client IPs before applying the durable daily limit.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RATE_LIMIT_SECRET=replace-with-a-random-32-byte-secret

# Public address displayed on /privacy. Use an inbox intended for website requests.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@example.com
