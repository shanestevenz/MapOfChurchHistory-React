# Neon connection strings. Use the pooled URL for app requests and the direct
# URL for schema changes, seeding, and Better Auth CLI operations.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better Auth runs in this app and stores users, sessions, and TOTP factors in Neon.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=YxpT0UzmoO-i2jVfn_m2hxn3piPU0ogLAL-et8hgZcqfBFcvoDFNdUkWWygIe9VU
# Optional comma-separated preview origins allowed by Better Auth.
BETTER_AUTH_TRUSTED_ORIGINS=

# Cloudflare Turnstile. Leave blank locally to use the development bypass.
# Production refuses curator sign-in and suggestions if the keys are missing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# HMAC key used to anonymize client IPs before enforcing the durable daily limit.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RATE_LIMIT_SECRET=replace-with-a-random-32-byte-secret

# Protects the scheduled Vercel suggestion-retention endpoint.
CRON_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Public address displayed on /privacy. Use an inbox intended for website requests.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@example.com

# ADmin email addresses allowed to access the admin dashboard. Comma-separated.
# admin@example.com
#password: jztMkh8Uo2IwFHF1mHPv2pdy5tB8EwAm